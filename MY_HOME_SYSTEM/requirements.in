# MY_HOME_SYSTEM/requirements.in — 実行時の直接依存(このリポジトリのソースが import する、
# または FastAPI 等が実行時に要求するパッケージ)だけを列挙する。
#
# requirements.txt はこのファイルから pip-compile(pip-tools)で生成した lock ファイルであり、
# 手で編集しない(Issue #647)。以前は pip freeze 形式の requirements.txt(117 行、うち直接
# import されるのは約 30)を手で保守しており、Dependabot が pydantic と pydantic_core を
# 独立に最新化して ResolutionImpossible になる(PR #636)など、推移的依存を固定していることが
# 更新の障害になっていた。
#
# 依存を追加・変更したら:
#   pip install pip-tools
#   pip-compile requirements.in            # 既存の pin は維持され、追加分だけ解決される
#   pip-compile requirements-dev.in        # -c requirements.txt で実行時側の版に揃える(ファイル内に指定済み)
# 更新は Dependabot(pip-compile 形式を認識する)か、`pip-compile --upgrade-package <name>` で行う。
# バージョンの上限は付けない(lock 側で固定する)。Python は .python-version(3.11)で解決すること。

# --- Web / API ---
fastapi
uvicorn
pydantic
# FastAPI の UploadFile / Form が実行時に要求する(routers/quest_router.py の upload_image)
python-multipart
aiofiles

# --- 外部連携 ---
requests
urllib3
line-bot-sdk
google-genai
ask-sdk-core
ask-sdk-model
# Alexa リクエストの署名検証(core/alexa_verifier.py)
cryptography
tenacity
python-dotenv

# --- IoT / カメラ ---
onvif_zeep
opencv-python-headless
psutil

# --- 解析・ダッシュボード ---
pandas
numpy
pytz
# ダッシュボードのホーム画面アイコン生成(services/dashboard_pwa_service.py)で直接 import
# する。以前は streamlit の推移的依存として入っていただけだった(#829でstreamlit自体は撤去)。
Pillow
# beautifulsoup4: services/mfujin_blog_service.py(えむふじんブログの記事HTML解析)が
# 直接importする。以前train_service.py専用だったため同機能の退役にあわせて一度外したが
# (Issue参照)、今回のブログ監視機能で再度必要になった。
beautifulsoup4
lxml

# --- DDD(バッチ処理) ---
# Issue #1090: 実機では DDD のスクリプトも MY_HOME_SYSTEM/.venv の python で動く(deploy/cron/crontab →
# run_task.sh。DDD は core.* / services.* も import するため、この venv の依存がそもそも必要)。
# 以前は DDD/requirements.txt を同じ venv へ後から別途 pip install しており、curl_cffi が要求する
# certifi/cffi の下限が lock の版より新しくなって、起動のたびにダウングレード→再アップグレードが
# 起き、実機の版が lock・CI と食い違っていた。DDD の直接依存もここに置き、1つの lock で解決する。
# (requests・beautifulsoup4 は上で宣言済み。DDD も使う)
# yt-dlp は exact pin にする(Issue #1038): YouTube 等の仕様変更で抽出が壊れやすく、下限指定だと
# Dependabot が更新PRを起票せず陳腐化に気づけなかった。Dependabot の週次PRで更新する。
yt-dlp==2026.10.26
# missav等、CloudflareのボットチャレンジがかかったCDN(surrit.com等)からm3u8を取得する際の
# ブラウザ偽装(impersonate)に必要(未インストールだと"Impersonate target ... is not available"で失敗する)
# 下限は実機で動作確認済みの版。付けないと pip-compile が既存の certifi/cffi の pin を優先して
# 古い curl_cffi(0.16 系)を選ぶ。
curl_cffi>=0.17.0
