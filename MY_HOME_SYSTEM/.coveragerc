[run]
source = .
omit =
    tests/*
    old/*
    monitors/*
    views/dashboard/*
    dashboard.py
    reset_game.py
    sync_strict.py
    train_service.py
    switchbot_webhook_fix.py
    post_boot_health_check.py
    */__init__.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
