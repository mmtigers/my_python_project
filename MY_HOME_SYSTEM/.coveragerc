[run]
source = .
# Issue #367: omit は「本当に実行不能なもの」だけに絞る。かつては専用テストが
# 存在するモジュール(monitors/*, sync_strict.py 等)まで除外しており、CIの
# カバレッジ値が実態より大きく水増しされ閾値が退行検知として機能していなかった。
#
# Issue #754: その残り分として `views/dashboard/*` が除外されたままだった。
# 「Streamlit のスクリプト実行モデルは単体テストで再現できない」ことと
# 「その中のロジックがテスト不能」であることは別で、実際に各 render 関数は
# `st` を差し替えれば Streamlit を起動せずに検証できる(tests/test_dashboard_*)。
# 除外したままではカバレッジのラチェット(master比0.5pt)がこの領域だけ効かず、
# 本番サービスを落とせる `sudo systemctl restart` ボタンの確認フローすら
# 検証されない状態が構造的に許されていた。
#
# #829: Streamlit版ダッシュボード(`dashboard.py`・`views/dashboard/*`)自体を
# 廃止した。「実行不能なので除外する」エントリが1件も残らなくなったため
# omit は tests/* と __init__.py だけになった。ここへ追加する場合は
# tests/test_coveragerc.py(各エントリが実在するパスに一致するかの回帰テストと
# 許可リスト)も参照。
omit =
    tests/*
    */__init__.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
