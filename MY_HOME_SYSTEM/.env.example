# MY_HOME_SYSTEM/.env.example
# Copy to .env and fill in real values. .env is gitignored; this file is tracked
# and must only ever contain placeholder / example values, never real secrets or
# personal data.
#
# config.py が os.getenv() で読む変数はすべてここに載せること。
# 対応関係は tests/test_env_example_consistency.py がCIで検証している。
# 節構成は config.py のセクション番号に対応。

# --- 1. 環境・機能フラグ設定 ---
# core/logger のログレベル (DEBUG / INFO / WARNING / ERROR / CRITICAL。既定 INFO。Issue #665)
LOG_LEVEL=INFO
# セキュリティヘッダー(X-Content-Type-Options / X-Frame-Options / Referrer-Policy)の付与。
# 既定 true。Cloudflare 側で同じヘッダーを付与していて重複させたくない場合のみ false にする。
SECURITY_HEADERS_ENABLED=true
# X-Frame-Options の値。既定 SAMEORIGIN。DENY にすると同一オリジンのiframe埋め込みも不可になる。
# 空文字にするとこのヘッダーだけ付与しない。
SECURITY_HEADER_X_FRAME_OPTIONS=SAMEORIGIN

# --- 2. 認証・API設定 (Secrets) ---
# SwitchBot 開発者向けAPI (アプリの「開発者向けオプション」で発行)
SWITCHBOT_API_TOKEN=your-switchbot-api-token
SWITCHBOT_API_SECRET=your-switchbot-api-secret
# SwitchBot Webhook (POST /webhook/switchbot) の共有シークレット。
# 未設定だと /webhook/switchbot は 503 で拒否される(フェイルクローズ。Issue #648)。
# SwitchBot開発者ポータル側のWebhook URLにも同じ値を ?token=... として設定すること。
SWITCHBOT_WEBHOOK_TOKEN=your-random-webhook-token
# 未設定のまま /webhook/switchbot を受け付けたい移行期間のみ true にする(既定 false = 503 で拒否。Issue #648)
ALLOW_UNAUTHENTICATED_SWITCHBOT_WEBHOOK=false
# switchbot_webhook_fix.py が Webhook URL を再登録するときの公開ベースURL(末尾スラッシュなし)
WEBHOOK_BASE_URL=https://home.example.com

# Nature Remo
NATURE_REMO_ACCESS_TOKEN=your-nature-remo-token
NATURE_REMO_ACCESS_TOKEN_TAKASAGO=your-nature-remo-token-takasago

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_PARENTS_GROUP_ID=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 体調・食事記録の書き込みとAI検索を許可する、家族のLINEユーザーIDのカンマ区切りallowlist。
# 未設定だと従来通り誰でも利用できる(後方互換)。有効にするには実際のuser_idを設定すること。
AUTHORIZED_LINE_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,Uyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Discord Webhook (用途別)
DISCORD_WEBHOOK_ERROR=https://discord.com/api/webhooks/000000/xxxxx
DISCORD_WEBHOOK_REPORT=https://discord.com/api/webhooks/000000/xxxxx
DISCORD_WEBHOOK_NOTIFY=https://discord.com/api/webhooks/000000/xxxxx
# レガシー: DISCORD_WEBHOOK_NOTIFY 未設定時のフォールバック
# (Issue #586: DDD/newface_monitor.pyもconfig.pyと同じ優先順位でこの2つを解決する)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000/xxxxx

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# --- 3. システム・パス設定 ---
# NASマウントポイント (テストでは ./tmp_nas を指定)
NAS_MOUNT_POINT=/mnt/nas
# SQLite DBファイルパス (未設定時は config.py と同じ場所の home_system.db。CI/テストは :memory:)
SQLITE_DB_PATH=

# --- 4. デバイス・ルール設定 ---
# 通知先: discord / line / none (テストでは none)
NOTIFICATION_TARGET=discord
# 人感検知のクールダウン秒数
MOTION_COOLDOWN_SEC=60

# --- 5. NAS & Network設定 ---
# NAS の IP。未設定なら ping 疎通確認をスキップする(マウント/書き込みで健全性を判定)。
NAS_IP=192.168.0.10
# family-questビルド成果物のパス (未設定時は ../family-quest/dist)
QUEST_DIST_DIR=
# LAN 内の他端末から family-quest を開くときの URL。未設定なら http://127.0.0.1:8000/quest。
FRONTEND_URL=http://192.168.0.2:8000/quest
# true にするとCORSが全オリジン許可になる (開発用)
ALLOW_ALL_ORIGINS=False
# CORS_ORIGINS に追加するオリジン(カンマ区切り)。公開ドメイン(Cloudflare Tunnel)や LAN 内の開発サーバー等、
# 個人環境の値はここに置く(config.py に直書きしない。Issue #663)
CORS_EXTRA_ORIGINS=https://home.example.com,http://192.168.0.2:5173
# アバター等アップロードの上限MB
UPLOAD_MAX_FILE_SIZE_MB=5
# reset_game.pyが呼び出す管理者向けリセットAPIのベースURL (未設定時はhttp://127.0.0.1:8000)
RESET_GAME_API_BASE_URL=

# --- 7. 保持期間・クリーンアップ設定 ---
RECORDING_RETENTION_DAYS=30
# 録画VODのHLSセグメントキャッシュ(data/hls_streams/vod)の保持日数 (Issue #359)
HLS_VOD_RETENTION_DAYS=3
DB_BACKUP_RETENTION_DAYS=30

# --- 8. Sound & Family設定 ---
# BluetoothスピーカーのMACアドレス(未設定なら post_boot_health_check のスピーカーチェックをスキップ。Issue #663)
SPEAKER_BLUETOOTH_MAC=00:11:22:33:44:55

# --- 10. TVロック機能設定 ---
# TVアンロックの対象クエストID (カンマ区切りの整数)
TV_UNLOCK_QUEST_IDS=
# TV電源プラグ(SwitchBot)のデバイスID
TV_PLUG_DEVICE_ID=

# --- 11. Alexaスキル設定 (routers/alexa_router.py, handlers/alexa_handler.py) ---
# Alexa Developer Consoleでスキル作成時に発行される "amzn1.ask.skill.xxxx" 形式のID。
# 設定するとリクエストの applicationId 検証が有効になる(未設定でも動作するが非推奨)。
ALEXA_SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000

# ==========================================
# ラズパイ監視 層2: 異常検知時のClaude自動調査 (Issue #339)
# ==========================================
# health_watch.py が異常検知時に起動する調査フックの絶対パス。
# 空(既定)なら層1の検知・通知のみ。実機でClaude Code CLI・ghのセットアップと
# `claude --help` でのフラグ確認を終えてから、下記のようなパスを設定して有効化すること。
# 例: HEALTH_WATCH_INVESTIGATE_HOOK=/home/masahiro/develop/MY_HOME_SYSTEM/scripts/claude_investigate.sh
HEALTH_WATCH_INVESTIGATE_HOOK=
# 導入初期はドライラン(gh起票なし・調査結果の通知のみ)を推奨
# CLAUDE_INVESTIGATE_DRY_RUN=1
# CLAUDE_INVESTIGATE_PROJECT_DIR=/home/masahiro/develop
# CLAUDE_INVESTIGATE_TIMEOUT_SEC=900
# CLAUDE_INVESTIGATE_MAX_BUDGET_USD=2.00
# 調査結果の通知先(notification_serviceと同じDiscord WebhookのURLを再利用)
# WATCHDOG_NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# --- 14. Family Quest: YouTubeごほうび券クールダウン設定 ---
# クールダウン(15分/連続使用防止)の対象となるYouTube系ごほうび券のreward_id(カンマ区切り)。
# 未設定時は quest_data.py の既定値(10,11,12)が使われる。空文字にすると機能を無効化する。
YOUTUBE_REWARD_IDS=
# クールダウンを実際に強制し始める日(YYYY-MM-DD、JST基準)。この日より前は制限せず、
# family-quest側に予告バナーのみ表示する。未設定時は config.py の既定値が使われる。
YOUTUBE_REWARD_COOLDOWN_ENFORCE_FROM=

# --- 15. 週次レポート設定 ---
# weekly_analyze_report.py が電力量(kWh)から電気代を概算するときの単価(円/kWh)。
# 地域・契約で変わるため .env で設定する。未設定時は config.py の既定値(31)が使われる。
ELEC_PRICE_PER_KWH=31

# --- 16. DDD (バッチ処理。MY_HOME_SYSTEM の .venv/.env を共用する。Issue #663) ---
# DDD/batch_download_discord.py
ENABLE_YOUTUBE_DL=false
VIDEO_SAVE_DIR=/mnt/nas/ddd
DDD_REQUIRE_NAS_MOUNT=true
DDD_LOCAL_TMP_DIR=
DDD_LOCAL_TMP_MIN_FREE_SPACE_GB=10
DDD_REQUEST_TIMEOUT=20
# yt-dlp に渡す cookies.txt のパス(任意)
YOUTUBE_COOKIES_FILE=
# DDD/file_utils.py: MY_HOME_SYSTEM の場所を明示する(通常は相対位置から自動解決されるため未設定でよい)
MY_HOME_SYSTEM_ROOT=
# 上の 3. で定義した NAS_MOUNT_POINT は DDD の3スクリプト(batch_download_discord /
# newface_monitor / extract_youtube_urls)からも参照される(Issue #663 で直書きを解消)。
# DDD 側は config.py を import せず環境変数を直接読む(MY_HOME_SYSTEM 無しでも動くため)。
