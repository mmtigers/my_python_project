# MY_HOME_SYSTEM/.env.example
# Copy to .env and fill in real values. .env is gitignored; this file is tracked
# and must only ever contain placeholder / example values, never real secrets or
# personal data.

# --- Home loan simulation (tools/financial_service.py) ---
# Loan start date (YYYY-MM-DD)
FINANCIAL_START_DATE=2024-01-01
# Total loan principal (JPY, integer)
FINANCIAL_TOTAL_AMOUNT=50000000
# Total number of monthly installments
FINANCIAL_TOTAL_MONTHS=420
# Initial monthly payment (JPY, integer)
FINANCIAL_INITIAL_PAYMENT=140000
# Confirmed interest-rate schedule as a JSON array of
# [start_date, end_date_or_null, annual_rate_percent] tuples.
FINANCIAL_RATE_SCHEDULE=[["2024-01-01","2024-12-31",0.5],["2025-01-01",null,0.7]]
# Optional: rate/date used to project rates after the confirmed schedule ends.
# If omitted, these are derived automatically from the last schedule entry.
FINANCIAL_PROJECTION_BASE_RATE=0.9
FINANCIAL_PROJECTION_BASE_DATE=2026-01-01

# --- Asset breakdown defaults shown in the simulation sidebar (JPY, integer) ---
# All optional; default to 0 if unset (the simulator still works, just starts
# from a blank asset breakdown that the user can fill in by hand each time).
FINANCIAL_ASSET_CASH=1000000
FINANCIAL_ASSET_STOCK=1000000
FINANCIAL_ASSET_TRUST=1000000
FINANCIAL_ASSET_PENSION=1000000
FINANCIAL_ASSET_POINT=10000
