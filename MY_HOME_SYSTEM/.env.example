# MY_HOME_SYSTEM/.env.example
# Copy to .env and fill in real values. .env is gitignored; this file is tracked
# and must only ever contain placeholder / example values, never real secrets or
# personal data.
#
# config.py が os.getenv() で読む変数はすべてここに載せること。
# 対応関係は tests/test_env_example_consistency.py がCIで検証している。
# 節構成は config.py のセクション番号に対応。

# --- 1. 環境・機能フラグ設定 ---
# development / production
ENV=development

# --- 2. 認証・API設定 (Secrets) ---
# SwitchBot 開発者向けAPI (アプリの「開発者向けオプション」で発行)
SWITCHBOT_API_TOKEN=your-switchbot-api-token
SWITCHBOT_API_SECRET=your-switchbot-api-secret
# SwitchBot Webhook (POST /webhook/switchbot) の共有シークレット。
# 未設定だと署名検証がスキップされ誰でも呼び出せる(起動時に警告が出る)。
# SwitchBot開発者ポータル側のWebhook URLにも同じ値を ?token=... として設定すること。
SWITCHBOT_WEBHOOK_TOKEN=your-random-webhook-token

# Nature Remo
NATURE_REMO_ACCESS_TOKEN=your-nature-remo-token
NATURE_REMO_ACCESS_TOKEN_TAKASAGO=your-nature-remo-token-takasago

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_PARENTS_GROUP_ID=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Discord Webhook (用途別)
DISCORD_WEBHOOK_ERROR=https://discord.com/api/webhooks/000000/xxxxx
DISCORD_WEBHOOK_ERROR_CAM=https://discord.com/api/webhooks/000000/xxxxx
DISCORD_WEBHOOK_REPORT=https://discord.com/api/webhooks/000000/xxxxx
DISCORD_WEBHOOK_NOTIFY=https://discord.com/api/webhooks/000000/xxxxx
# レガシー: DISCORD_WEBHOOK_NOTIFY 未設定時のフォールバック
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000/xxxxx

# Gmail (給与明細取得等) / Gemini
GMAIL_USER=example@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
GEMINI_API_KEY=your-gemini-api-key
# 給与明細メールの送信元アドレス
SALARY_MAIL_SENDER=payroll@example.com

# 不動産情報ライブラリ (REINFOLIB)
REINFOLIB_API_KEY=your-reinfolib-api-key

# --- 3. システム・パス設定 ---
# NASマウントポイント (テストでは ./tmp_nas を指定)
NAS_MOUNT_POINT=/mnt/nas
# SQLite DBファイルパス (未設定時は config.py と同じ場所の home_system.db。CI/テストは :memory:)
SQLITE_DB_PATH=

# --- 4. デバイス・ルール設定 ---
# 通知先: discord / line / none (テストでは none)
NOTIFICATION_TARGET=discord
# 子供の名前 (カンマ区切り。LINE Bot応答の表示等に使用)
CHILDREN_NAMES=
# 人感検知のクールダウン秒数
MOTION_COOLDOWN_SEC=60

# --- 5. 給与(Salary)設定 ---
# 給与明細PDFのパスワード候補 (カンマ区切り)
SALARY_PDF_PASSWORDS=

# --- 10. NAS & Network設定 ---
NAS_IP=192.168.1.20
# family-questビルド成果物のパス (未設定時は ../family-quest/dist)
QUEST_DIST_DIR=
FRONTEND_URL=http://192.168.1.200:8000/quest
# true にするとCORSが全オリジン許可になる (開発用)
ALLOW_ALL_ORIGINS=False
# アバター等アップロードの上限MB
UPLOAD_MAX_FILE_SIZE_MB=5

# --- 12. 保持期間・クリーンアップ設定 ---
RECORDING_RETENTION_DAYS=30
DB_BACKUP_RETENTION_DAYS=30

# --- 13. Sound & Family設定 ---
# BluetoothスピーカーのMACアドレス
SPEAKER_BLUETOOTH_MAC=00:11:22:33:44:55

# --- 14. 外部サイト監視設定 (SUUMO) ---
SUUMO_SEARCH_URL=https://suumo.jp/jj/bukken/ichiran/JJ012FC001/?ar=060&bs=030
# --- 15. 小児科予約監視設定 (Clinic Monitor) ---
CLINIC_MONITOR_URL=https://ssc6.doctorqube.com/itami-shounika/
CLINIC_MONITOR_START_HOUR=8
CLINIC_MONITOR_END_HOUR=19
CLINIC_REQUEST_TIMEOUT=10
CLINIC_USER_AGENT=MyHomeSystem/1.0 (Family Health Monitor)

# --- 17. TVロック機能設定 ---
# TVアンロックの対象クエストID (カンマ区切りの整数)
TV_UNLOCK_QUEST_IDS=
# TV電源プラグ(SwitchBot)のデバイスID
TV_PLUG_DEVICE_ID=

# --- 18. Alexaスキル設定 (routers/alexa_router.py, handlers/alexa_handler.py) ---
# Alexa Developer Consoleでスキル作成時に発行される "amzn1.ask.skill.xxxx" 形式のID。
# 設定するとリクエストの applicationId 検証が有効になる(未設定でも動作するが非推奨)。
ALEXA_SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000
