[Unit]
Description=Post Boot Health Check Service
After=network-online.target home_system.service
Wants=network-online.target

[Service]
Type=oneshot
User=masahiro
Group=masahiro

# サービス起動待ちリトライ(最大2分)を考慮しても10分あれば完了する。
# スクリプト内のsubprocessがハングしても、ここで強制的に打ち切る(最終防衛線)
TimeoutStartSec=600

# 1. 作業ディレクトリ
# スクリプト内で 'import config' 等を行うため、MY_HOME_SYSTEM直下を起点にします
WorkingDirectory=/home/masahiro/develop/MY_HOME_SYSTEM

# 2. 実行コマンド (修正ポイント)
# システムのpython3ではなく、仮想環境(.venv)のpython3を絶対パスで指定します
ExecStart=/home/masahiro/develop/MY_HOME_SYSTEM/.venv/bin/python3 post_boot_health_check.py

# 3. ログ出力
# 出力先ディレクトリが存在しないとエラーになるため、後述の手順で確認します
StandardOutput=append:/home/masahiro/develop/MY_HOME_SYSTEM/logs/health_check.log
StandardError=append:/home/masahiro/develop/MY_HOME_SYSTEM/logs/health_check.log

[Install]
WantedBy=multi-user.target
