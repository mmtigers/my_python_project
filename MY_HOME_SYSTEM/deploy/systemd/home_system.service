[Unit]
Description=My Home System Server
After=network.target
RequiresMountsFor=/mnt/nas

# クラッシュループの歯止め(5 分間に 5 回まで。超えたら failed で停止し、health_watch.py
# (毎時 cron)のチェック1「home_system.service が active か」で検知される)。
# StartLimitIntervalSec= / StartLimitBurst= は systemd v229/v230 以降 [Unit] セクションの
# ディレクティブで、[Service] に書くと新名の StartLimitIntervalSec= は解釈されない
# (実機 systemd 257 で `systemd-analyze verify` が
#  「Unknown key 'StartLimitIntervalSec' in section [Service], ignoring」を出すことを確認済み)。
# その状態では既定の DefaultStartLimitIntervalSec(10 秒)が適用され、コメントに書いた
# 「5 分間に 5 回まで」は成立していなかった(REPOSITORY_AUDIT_2026-09-18.md の AUDIT-002)。
StartLimitIntervalSec=300
StartLimitBurst=5
# 上限超過時は再起動を諦めて failed のまま停止する(既定値の明示)。
StartLimitAction=none

[Service]
# Issue #646: 以前は Type=oneshot + RemainAfterExit=yes で start_all.sh が unified_server.py を
# nohup/disown でバックグラウンド起動しており、サーバーが systemd の管理外にあった。
# unified_server.py がクラッシュしても systemd は何もせず(oneshot には Restart= が効かない)、
# 復旧は Discord 通知を受けた人手だった。Type=simple でサーバー本体をフォアグラウンドの
# メインプロセスにし、異常終了時は Restart=on-failure で自動復旧する。
Type=simple
User=masahiro
WorkingDirectory=/home/masahiro/develop/MY_HOME_SYSTEM
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PYTHONPATH=/home/masahiro/develop:/home/masahiro/develop/MY_HOME_SYSTEM

# 前処理(旧プロセスの掃除・NAS マウント待ち・.venv/dist の鮮度チェック・Webhook 再登録)。
# サーバー本体は起動しない(--prepare)。失敗しても start_all.sh 自身が警告のみで exit 0 する。
ExecStartPre=/home/masahiro/develop/MY_HOME_SYSTEM/start_all.sh --prepare
# サーバー本体。unified_server.py が内部で scheduler_boot.py / monitors/camera_monitor.py を起動し、
# 死活監視・再起動も行う(unified_server.py の restart_dead_children)。
#
# Issue #760 (AUDIT-031): 必ず単一プロセスで起動すること(uvicorn の --workers を
# 増やさない、gunicorn -w N に置き換えない)。quest_users(gold/exp/level/medal_count)の
# read-modify-write は services/quest/locks.py の threading.Lock だけで直列化しており、
# DB レベルの排他(BEGIN IMMEDIATE 等)は使っていない(#544 で入り #547 で撤去済み)。
# プロセスを増やすとロックが共有されず、**エラーを出さないまま**ゴールドが消える/増える
# (ロストアップデート)。性能上の必要が出た場合は、先に quest_users の更新を
# DB レベルで原子的な形(条件付き UPDATE / 楽観ロック)へ移すこと。
# この不変条件は .github/scripts/test_systemd_units.py と
# MY_HOME_SYSTEM/tests/test_single_process_invariant.py が固定している。
ExecStart=/home/masahiro/develop/MY_HOME_SYSTEM/.venv/bin/python3 unified_server.py

# start ジョブ全体(ExecStartPre の完走 → ExecStart の fork)に許す時間。未指定だと
# DefaultTimeoutStartSec(通常 90 秒)が適用されるが、ExecStartPre の start_all.sh --prepare は
# NAS マウント待ち(Exponential Backoff で最大 31 秒)・requirements.txt 変更時の pip install
# (117 パッケージ)・family-quest の再ビルド(npm ci + tsc -b && vite build)を含み、
# ラズパイでは数分かかる。90 秒で SIGTERM → Restart=on-failure で再試行、というループに
# 陥るため明示的に延ばす(REPOSITORY_AUDIT_2026-09-18.md の AUDIT-001)。
# 本当にハングした場合はここで打ち切られ、StartLimit*([Unit])の歯止めが働く。
TimeoutStartSec=900

# 異常終了(非0 exit / シグナル死)時のみ 10 秒後に再起動する。systemctl stop では再起動しない。
# 繰り返しクラッシュした場合の歯止め(StartLimit*)は [Unit] セクション側にある。
Restart=on-failure
RestartSec=10

# 停止時は SIGTERM をメインプロセスに送り、lifespan の終了処理(子プロセス terminate → 5 秒待ち →
# kill、ffmpeg 停止)を待つ。残った子は TimeoutStopSec 後に SIGKILL される。
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
