[Unit]
Description=My Home System Streamlit Dashboard (localhost only)
After=network.target home_system.service

[Service]
# Issue #646: 以前は start_all.sh が nohup でバックグラウンド起動していた Streamlit ダッシュボードを、
# home_system.service(Type=simple 化)から切り離して独立ユニットで管理する。
# 認証なしのため外部公開せずローカルホストのみにバインドする(start_all.sh の Phase 4 と同じ引数)。
Type=simple
User=masahiro
WorkingDirectory=/home/masahiro/develop/MY_HOME_SYSTEM
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PYTHONPATH=/home/masahiro/develop:/home/masahiro/develop/MY_HOME_SYSTEM
ExecStart=/home/masahiro/develop/MY_HOME_SYSTEM/.venv/bin/python3 -m streamlit run dashboard.py --server.port 8501 --server.address 127.0.0.1 --server.headless true
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
