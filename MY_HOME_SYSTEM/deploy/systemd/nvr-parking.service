[Unit]
Description=NVR Recording Service for Parking Camera
# ネットワークとNASマウント完了を待つ(NASが未マウントのまま起動すると、
# ローカルのSDカードへ録画を書き続けてしまうため Requires= で強く依存させる)
After=network.target mnt-nas.mount
Requires=mnt-nas.mount

[Service]
User=masahiro
Group=masahiro
Restart=always
# 再起動の待機時間。最初は10秒で、連続して失敗する間は RestartSteps 回かけて
# RestartMaxDelaySec(5分)まで指数的に延ばす(systemd 254 以降。実機は 257)。
# カメラが復旧しない間に10秒ごとの再起動と細切れのMP4(正常は1日144本のところ
# 334本の日があった)が続くのを防ぐ(Issue #1171)。一時的な切断(1回のEOF)からの
# 復旧は最初の10秒のままで、ffmpeg が起動後しばらく動き続ければ間隔は元に戻る。
RestartSec=10s
RestartSteps=5
RestartMaxDelaySec=5min

# ログ出力設定 (journalctlで見れるように)
StandardOutput=journal
StandardError=journal

# Issue #773: RTSPのURLはユーザー名・パスワードを含むため、ユニット本文には書かず
# 実機の /etc/nvr/parking.env (600・root所有・gitignore対象外=リポジトリには存在しない)
# から NVR_RTSP_URL として読み込む。以前は ExecStart に平文で書かれたユニットが
# 644 で置かれており、リポジトリ管理もされていなかった。
EnvironmentFile=/etc/nvr/parking.env
# Issue #890: ffmpeg は入力失敗時に認証情報付きの rtsp URL をそのまま出力するため、journal へ残さない
LogFilterPatterns=~rtsp://[^[:space:]]*@

# --- FFmpeg Command ---
# -timeout 20000000: 20秒間データが来なければ諦めて終了する(Restart=always で再接続)。
#   これが無いと、カメラがTCP接続を保ったままデータを送らなくなった場合に ffmpeg が
#   無限に待ち、プロセスは生きているので systemd も再起動せず録画だけが静かに止まる
#   (Issue #772 で garden のみ欠落していたのを実機で修正済み)。
# -rtsp_transport tcp: 安定性重視
# -c copy: 無劣化コピー (CPU負荷最小)
# -tag:v hvc1: H.265 を一般的なプレイヤーが再生できるタグで格納する
# -f segment / -segment_time 600: 10分ごとにファイル分割
# -segment_format_options ...: 【重要】電源断時のファイル破損防止フラグ
# -strftime 1: ファイル名に日時を使用(monitors/health_watch.py のチェック10が、
#   この命名規則の最新ファイル時刻を見て録画停止を検知する)
ExecStart=/usr/bin/ffmpeg \
    -hide_banner -loglevel error \
    -timeout 20000000 \
    -rtsp_transport tcp -y \
    -i "${NVR_RTSP_URL}" \
    -c copy \
    -c:a aac \
    -tag:v hvc1 \
    -f segment \
    -segment_time 600 \
    -segment_format_options movflags=+faststart+frag_keyframe+empty_moov \
    -segment_format mp4 \
    -reset_timestamps 1 \
    -strftime 1 \
    "/mnt/nas/home_system/nvr_recordings/parking/%%Y%%m%%d_%%H%%M%%S.mp4"

[Install]
WantedBy=multi-user.target
