# Python bytecode
*.pyc
__pycache__/

# Node (no root-level Node project; family-quest/ has its own .gitignore)
/node_modules/

# Virtual Environments (Anywhere)
venv/
.venv/

# Environment Variables
.env

# Editor
.vscode/

# Logs
*.log
*.csv
logs/

# Temporary
tmp/
*.done
*.ts
*.m3u8

# Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.db.*
*.bak

# Backups
MY_HOME_SYSTEM/db_backup/

# MY_HOME_SYSTEM: runtime lock files (created by monitors at runtime, not source)
MY_HOME_SYSTEM/watchdog_alert_sent.lock
MY_HOME_SYSTEM/watchdog_throttle_history.state

# Private Assets (Images, PDFs)
assets/snapshots/
assets/salary_images/
*.jpg
*.png
*.pdf
*.mp4
*.txt

# DDD: personal generated content, not source
DDD/split_results/
DDD/*プロンプト*.md
DDD/.batch_download_discord.lock
DDD/.bot_detection_cooldown

# ただし requirements.txt / requirements-dev.txt は含める
!requirements.txt
!requirements-dev.txt

*.zip
*.mp3
*.json
family_events.json
# Explicit (defense-in-depth) in case the broad *.json rule above is ever narrowed:
*.local.json

# family-quest: the blanket *.ts rule above targets HLS transport-stream
# segments (video, generated at runtime), and the blanket *.json rule targets
# personal data files — neither is meant to exclude this app's own committed
# source/config. Explicitly un-ignore them so the project stays buildable.
!family-quest/**/*.ts
!family-quest/package.json
!family-quest/package-lock.json
!family-quest/tsconfig*.json

# Test / Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.pytest_cache/
tmp_nas/
temp_fallback/
temp_backups/
