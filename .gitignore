# Python bytecode
*.pyc
__pycache__/

# Node (no root-level Node project; family-quest/ has its own .gitignore)
/node_modules/

# Virtual Environments (Anywhere)
venv/
.venv/

# Environment Variables
.env

# Editor
.vscode/
*.code-workspace

# Claude Code local state
.claude/worktrees/

# Logs
*.log
*.csv
logs/

# Temporary
tmp/
*.done
*.ts
*.m3u8

# Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.db.*
*.bak

# Backups
MY_HOME_SYSTEM/db_backup/

# MY_HOME_SYSTEM: runtime lock files (created by monitors at runtime, not source)
MY_HOME_SYSTEM/watchdog_alert_sent.lock
MY_HOME_SYSTEM/watchdog_throttle_history.state
# MY_HOME_SYSTEM: timelapse runtime working dir (frames/lock, not source)
MY_HOME_SYSTEM/work/

# Private Assets (Images, PDFs)
assets/snapshots/
assets/salary_images/
*.jpg
*.png
*.pdf
*.mp4
*.txt
# Issue #187: 上記の*.pngは個人的なプライベート画像(カメラスナップショット等)を
# 想定した除外ルールだが、family-quest/public/配下のPWAアイコン・favicon等の
# フロントエンドソースアセットまで巻き込んで無条件にgit管理外にしてしまい、
# コード側(vite.config.ts, index.html)が参照する実ファイルが一度もコミットされず
# 常に404になる不具合の一因になっていた。ビルド成果物ではなくソースとして
# コミットが必要なこのディレクトリのみ明示的に除外対象から戻す。
!family-quest/public/*.png

# DDD: personal generated content, not source
DDD/split_results/
DDD/*プロンプト*.md
DDD/.batch_download_discord.lock
DDD/.newface_monitor.lock
DDD/.bot_detection_cooldown

# ただし requirements.txt / requirements-dev.txt は含める
!requirements.txt
!requirements-dev.txt

*.zip
*.mp3
*.json
family_events.json
# Explicit (defense-in-depth) in case the broad *.json rule above is ever narrowed:
*.local.json

# family-quest: the blanket *.ts rule above targets HLS transport-stream
# segments (video, generated at runtime), and the blanket *.json rule targets
# personal data files — neither is meant to exclude this app's own committed
# source/config. Explicitly un-ignore them so the project stays buildable.
!family-quest/**/*.ts
!family-quest/package.json
!family-quest/package-lock.json

# alexa-skill / MY_HOME_SYSTEM/alexa: this project's own committed Alexa skill
# config (interaction model, skill manifest, APL document), not personal data —
# same reasoning as the family-quest exception above.
!alexa-skill/**/*.json
!MY_HOME_SYSTEM/alexa/**/*.json
!family-quest/tsconfig*.json
# family-quest: the blanket *.mp3 rule above targets personal media, not this
# app's own sound-effect assets referenced by useSound.ts.
!family-quest/public/*.mp3

# Test / Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.pytest_cache/
tmp_nas/
temp_fallback/
temp_backups/
