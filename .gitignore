# Python bytecode
*.pyc
__pycache__/

# Node (no root-level Node project; family-quest/ has its own .gitignore)
/node_modules/

# Virtual Environments (Anywhere)
venv/
.venv/

# Environment Variables
# Issue #406: .env.local / .env.production 等の派生ファイルも除外する。
# .env.example はプレースホルダーのみのテンプレートなのでコミット対象(打ち消し)。
.env
.env.*
!.env.example

# Editor / OS
.vscode/
*.code-workspace
.DS_Store

# Claude Code local state
.claude/worktrees/

# Logs
*.log
logs/

# Temporary
tmp/
*.done
*.m3u8

# Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.db.*
*.bak

# Backups
MY_HOME_SYSTEM/db_backup/

# MY_HOME_SYSTEM: runtime lock files (created by monitors at runtime, not source)
MY_HOME_SYSTEM/watchdog_alert_sent.lock
MY_HOME_SYSTEM/watchdog_throttle_history.state
# MY_HOME_SYSTEM: timelapse runtime working dir (frames/lock, not source)
MY_HOME_SYSTEM/work/

# Issue #406: 個人データ(画像・CSV・JSON・HLSセグメント等)の除外は、以前は
# *.csv / *.ts / *.png / *.txt / *.json をリポジトリ全域に掛け、family-quest の
# ソース(*.ts)・PWAアイコン(public/*.png)・テストフィクスチャ(tests/fixtures/*.json)
# 等を !打ち消しで個別に戻していた。打ち消し漏れによるコミット漏れ事故
# (Issue #187: PWAアイコン、Issue #330: フィクスチャJSON)が構造的に再発するため、
# 実際に個人データが生成されるディレクトリ/ファイルに限定する(config.py 参照)。
# 新しい実行時データの保存先を増やした場合は、ここにその場所を追加すること。

# MY_HOME_SYSTEM: ローカル専用の設定・認証情報(いずれも *.example がテンプレート)
MY_HOME_SYSTEM/devices.json
MY_HOME_SYSTEM/family_events.json
MY_HOME_SYSTEM/google_photos_credentials.json
MY_HOME_SYSTEM/google_photos_token.json
MY_HOME_SYSTEM/switchbot_device_states.json
*.local.json
# MY_HOME_SYSTEM: 実行時に生成される個人データの保存先
# uploads/ = アバター画像(.jpg/.png に加え .webp/.gif も受理するためディレクトリごと除外)
MY_HOME_SYSTEM/uploads/
# assets/ = NAS未接続時のローカルフォールバック先(カメラスナップショット・給与明細画像・CSV等)
MY_HOME_SYSTEM/assets/
# data/ = HLS配信のセグメント(.ts)・プレイリスト(.m3u8)
MY_HOME_SYSTEM/data/
# 上記以外の場所に出力されうる個人メディア/CSV(MY_HOME_SYSTEM 配下にコミット対象の
# 画像・音声・CSVは存在しない)
MY_HOME_SYSTEM/**/*.jpg
MY_HOME_SYSTEM/**/*.png
MY_HOME_SYSTEM/**/*.pdf
MY_HOME_SYSTEM/**/*.mp4
MY_HOME_SYSTEM/**/*.mp3
MY_HOME_SYSTEM/**/*.csv

# DDD: personal generated content, not source
DDD/split_results/
DDD/*プロンプト*.md
DDD/.batch_download_discord.lock
DDD/.newface_monitor.lock
DDD/.bot_detection_cooldown
# DDD: ダウンロード対象リスト・履歴・監視データ(known_casts_*.json 等)
DDD/list/
DDD/list.txt
DDD/history.txt
DDD/data/
DDD/*.json
# DDD 配下にコミット対象の画像・動画・音声は存在しない
DDD/**/*.jpg
DDD/**/*.png
DDD/**/*.pdf
DDD/**/*.mp4
DDD/**/*.mp3
DDD/**/*.csv

*.zip

# Test / Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.pytest_cache/
.ruff_cache/
tmp_nas/
temp_fallback/
temp_backups/
