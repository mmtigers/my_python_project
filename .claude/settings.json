{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash deploy/claude-skills/install.sh --check --only-drift 2>&1 | grep -v '^up-to-date' || true",
            "timeout": 10,
            "statusMessage": "共通Skillsの同期を確認中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/spec_drift_reminder.py record 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "仕様書ドリフト追跡を更新中..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/spec_drift_reminder.py report 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "仕様書ドリフトを確認中..."
          }
        ]
      }
    ]
  }
}
